# FeatherAuth server.yaml for built-in TLS (tls.mode files): the service ends TLS
# itself, with no reverse proxy in front. Copy it to server.yaml in the
# configuration directory, with the certificate and the key it names.
# Every option is listed with its default, except public_url, which has none.
# "live" options apply on reload (SIGHUP or a file change); "restart" options
# are reported as "restart required" and apply after the next restart.
# Paths of secret files are relative to this directory.

# External base URL of the service (restart). It is part of every issuer and
# redirect URL. Required: https://host, no trailing slash.
public_url: https://auth.example.com

# Address of the loopback listener (restart). With tls.mode files it must be a
# loopback address, and it serves /healthz and /readyz only: featherauth healthcheck
# calls it. The environment variable FEATHERAUTH_LISTEN overrides it.
listen: "127.0.0.1:8080"

# Built-in TLS (restart). files makes the service end TLS itself with the
# certificate and key below. The loopback listen then serves /healthz and /readyz
# only, and trusted_proxies must stay empty.
tls:
  # files: the service ends TLS with the files below.
  mode: files
  # Address of the HTTPS listener. host:port or :port.
  listen: ":8443"
  # Address of the plain listener that answers every request with a 301 to the
  # same URL under public_url. Empty opens none.
  http_listen: ":8081"
  # PEM certificate chain, relative to this directory.
  cert_file: secrets/tls_cert.pem
  # PEM private key, a secret file: its permissions are checked as those of the
  # other secret files are, relative to this directory.
  key_file: secrets/tls_key.pem

# Secret files of the service itself.
secrets:
  # Keys that encrypt the provider refresh tokens FeatherAuth stores (restart).
  # Each file holds 32 random bytes as base64; "featherauth keys generate
  # --type encryption <file>" writes one. The first file encrypts, every file
  # can decrypt. Required when an enabled provider has store_refresh_token:
  # true; otherwise a file that does not exist is skipped.
  encryption_key_files:
    - secrets/encryption_key

# Require public_url to be https (restart). false is for local development only.
require_https: true

# true (the default) makes a secret file readable by its group or others an error
# at load and in "config check" (restart); false logs a warning for it instead.
strict_permissions: true

# Log verbosity (live): debug, info, warn or error. Logs never contain tokens,
# codes or secrets.
log_level: info

# Addresses of the reverse proxies whose X-Forwarded-For header is believed
# (live), as CIDRs, for example ["127.0.0.1/32"]. Empty ignores the header.
trusted_proxies: []

# Request rate limit.
rate_limit:
  # Requests per minute per client IP on authorize, callback, token and
  # provider events (live). 0 disables the limit. Users behind one shared
  # address share one limit, so raise it if that happens.
  per_ip_per_minute: 30
  # Where the counts are kept (restart). memory: each instance counts for itself.
  # database: the counts are shared through the database, which needs
  # driver: postgres in database.yaml; the limit then holds across instances.
  store: memory

# Path templates (restart). Placeholders: {prefix} is urls.path_prefix, {realm}
# the realm name, {provider} the provider name (callback and provider_events
# only). Every template needs {realm}, every path starts with "/", and no two
# endpoints may resolve to the same path.
urls:
  # The {prefix} placeholder below, and part of the issuer: empty or a path
  # starting with "/" (for example /auth).
  path_prefix: ""
  # Issuer path. Discovery is always <issuer>/.well-known/openid-configuration.
  issuer: "{prefix}/{realm}"
  # The path of each endpoint.
  endpoints:
    # Path that starts a login.
    authorize: "{prefix}/{realm}/authorize"
    # Code exchange and refresh.
    token: "{prefix}/{realm}/token"
    # User info.
    userinfo: "{prefix}/{realm}/userinfo"
    # Public signing keys.
    jwks: "{prefix}/{realm}/jwks.json"
    # Logout.
    logout: "{prefix}/{realm}/logout"
    # Revocation of a token (RFC 7009): a refresh or access token ends its session.
    revoke: "{prefix}/{realm}/revoke"
    # The user's sessions, listed with an access token of a client that has
    # allow_session_management.
    sessions: "{prefix}/{realm}/sessions"
    # Where providers return after login; this is the URL registered at each
    # provider. Must contain {provider}.
    callback: "{prefix}/{realm}/callback/{provider}"
    # Account deletion.
    account_delete: "{prefix}/{realm}/account"
    # Stylesheet and provider logos of the chooser and error pages.
    assets: "{prefix}/{realm}/assets"
    # Where Apple posts server-to-server notifications and Meta posts its
    # data-deletion callback; this URL is registered at Apple, and with the
    # Facebook provider's key as {provider} (it must be https) in the Meta app
    # as the data deletion request URL. Must contain {provider}.
    provider_events: "{prefix}/{realm}/events/{provider}"
    # Data-deletion instructions page; its URL is entered in the Meta app
    # settings. Opened with the confirmation code that Meta's callback returns,
    # it also shows that code.
    data_deletion: "{prefix}/{realm}/data-deletion"

# Provider hints on the authorize endpoint.
login:
  # Parameter names (query or form) accepted on authorize to skip the chooser
  # and go straight to a provider (live).
  provider_hint_params: [provider]

# Logout.
logout:
  # Parameter names (query or form) accepted for the logout return URL (live).
  # The value is always checked against the client's post-logout URIs. A name
  # other than post_logout_redirect_uri is a legacy name (for example
  # redirect_uri), the only kind redirected without an id_token_hint or a
  # client_id.
  redirect_params: [post_logout_redirect_uri]

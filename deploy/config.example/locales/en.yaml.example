# Translation file example: every message id with its English text.
# Copy it to locales/<code>.yaml, translate the values, and list <code> in
# login_page.supported_locales. An id that is missing shows in English.
# {name} stands for the provider's name.
chooser.log_in_with: "Log in with {name}"
